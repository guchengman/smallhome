---
import '../styles/global.css';
import '../styles/components.css';
import '../styles/mobile.css';
import '../styles/graphics.css';
import type { LocaleCode } from '../i18n/types';
import { getTranslations } from '../i18n/index';

const locale = (Astro.locale || 'zh') as LocaleCode;
const t = getTranslations(locale);
const path = Astro.url.pathname;
const isHome = path === '/' || path === '/zh' || path === '/zh/' || path === '/en' || path === '/en/';

const navItems = [
  { href: 'area/30-40sqm', label: t.nav.area },
  { href: 'space/kitchen', label: t.nav.space },
  { href: 'style/nordic', label: t.nav.style },
  { href: 'budget/under-30k', label: t.nav.budget },
  { href: 'tips', label: t.nav.tips },
  { href: 'gallery', label: t.nav.gallery },
  { href: 'tools/budget-calc', label: t.nav.tools },
];
---

<!DOCTYPE html>
<html lang={locale} dir="ltr">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>小家装修指南 SmallHome</title>
  <meta name="description" content={t.home.heroSubtitle} />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="alternate" hreflang="zh" href={`https://smallhome.xyz${path.replace(/^\/en/, '') || '/'}`} />
  <link rel="alternate" hreflang="en" href={`https://smallhome.xyz${path.startsWith('/en') ? path : '/en' + path}`} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Noto+Sans+SC:wght@400;500;700&family=Noto+Serif+SC:wght@400;700&family=ZCOOL+XiaoWei&display=swap" rel="stylesheet" />
  <script>
    // Prevent FOUC for theme/mobile detection
    (function(){
      var saved = localStorage.getItem('smallhome-locale');
      var isZhPath = location.pathname.startsWith('/zh');
      var isEnPath = location.pathname.startsWith('/en');
      if (saved === 'en' && !isEnPath) {
        var path = location.pathname;
        if (isZhPath) path = path.replace(/^\/zh/, '') || '/';
        location.replace('/en' + path);
      } else if (saved === 'zh' && !isZhPath) {
        var path = location.pathname;
        if (isEnPath) path = path.replace(/^\/en/, '') || '/';
        location.replace('/zh' + path);
      }
    })();
  </script>
</head>
<body>
  <!-- Reading progress bar -->
  <div class="reading-progress" id="reading-progress" style="width:0%"></div>

  <!-- Navigation -->
  <nav class="nav" id="nav">
    <div class="nav__inner">
      <a href={locale === 'zh' ? '/zh/' : '/en/'} class="nav__logo">SmallHome</a>
      <div class="nav__links hide-sm">
        {navItems.map(item => (
          <a href={`/${locale}/${item.href}`}>{item.label}</a>
        ))}
      </div>
      <div class="nav__spacer"></div>
      <div class="nav__actions">
        <a href="/search" class="btn btn-ghost hide-xs" aria-label={t.nav.search}>
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg>
        </a>
        <div class="hide-sm">
          <a href={locale === 'zh' ? '/en/' : '/zh/'} class="btn btn-ghost" title={t.nav.language} onclick="localStorage.setItem('smallhome-locale', '{locale === 'zh' ? 'en' : 'zh'}')">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M2 12h20M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>
            {locale === 'zh' ? 'EN' : '中文'}
          </a>
        </div>
        <span id="auth-area">
          <a href="/login" class="btn btn-outline">{t.nav.login}</a>
          <a href="/login?mode=register" class="btn btn-primary">{t.nav.register}</a>
        </span>
        <button class="hamburger" id="hamburger" aria-label="Menu">
          <span></span><span></span><span></span>
        </button>
      </div>
    </div>
  </nav>

  <!-- Mobile menu -->
  <div class="mobile-menu" id="mobile-menu">
    <div class="mobile-menu__panel">
      <div style="display:flex;justify-content:flex-end;margin-bottom:1rem">
        <button class="btn btn-ghost" id="menu-close" style="font-size:1.2rem">&times;</button>
      </div>
      {navItems.map(item => (
        <a href={`/${locale}/${item.href}`} style="display:block;padding:.75rem;border-bottom:1px solid var(--border);color:var(--text)">{item.label}</a>
      ))}
      <a href={locale === 'zh' ? '/en/' : '/zh/'} style="display:block;padding:.75rem;margin-top:1rem;color:var(--primary);font-weight:500" onclick="localStorage.setItem('smallhome-locale', '{locale === 'zh' ? 'en' : 'zh'}')">{t.nav.language}</a>
    </div>
  </div>

  <!-- Main content -->
  <main>
    <slot />
  </main>

  <!-- Footer -->
  <footer class="footer">
    <div class="footer__grid">
      <div class="footer__col">
        <h4>{t.footer.about}</h4>
        <a href={locale === 'zh' ? '/zh/articles/about' : '/en/articles/about'}>SmallHome.xyz</a>
        <a href={locale === 'zh' ? '/zh/articles/contact' : '/en/articles/contact'}>{locale === 'zh' ? '联系我们' : 'Contact'}</a>
      </div>
      <div class="footer__col">
        <h4>{t.footer.categories}</h4>
        <a href={locale === 'zh' ? '/zh/area/30-40sqm' : '/en/area/30-40sqm'}>{t.nav.area}</a>
        <a href={locale === 'zh' ? '/zh/space/kitchen' : '/en/space/kitchen'}>{t.nav.space}</a>
        <a href={locale === 'zh' ? '/zh/style/nordic' : '/en/style/nordic'}>{t.nav.style}</a>
        <a href={locale === 'zh' ? '/zh/budget/under-30k' : '/en/budget/under-30k'}>{t.nav.budget}</a>
        <a href={locale === 'zh' ? '/zh/tips' : '/en/tips'}>{t.nav.tips}</a>
        <a href={locale === 'zh' ? '/zh/gallery' : '/en/gallery'}>{t.nav.gallery}</a>
      </div>
      <div class="footer__col">
        <h4>{t.footer.links}</h4>
        <a href={locale === 'zh' ? '/zh/tools/budget-calc' : '/en/tools/budget-calc'}>{t.tools.budgetCalc}</a>
        <a href={locale === 'zh' ? '/zh/tools/material-calc' : '/en/tools/material-calc'}>{t.tools.materialCalc}</a>
      </div>
    </div>
    <div class="footer__bottom">
      <p>{t.footer.copyright}</p>
    </div>
  </footer>

  <!-- Bottom nav (mobile) -->
  <nav class="bottom-nav" id="bottom-nav">
    <a href={locale === 'zh' ? '/zh/' : '/en/'} aria-current={isHome ? 'page' : undefined}>
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
      {t.nav.home}
    </a>
    <a href={locale === 'zh' ? '/zh/area/30-40sqm' : '/en/area/30-40sqm'}>
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M3 9h18M9 21V9"/></svg>
      {t.nav.area}
    </a>
    <a href={locale === 'zh' ? '/zh/budget/under-30k' : '/en/budget/under-30k'}>
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
      {t.nav.budget}
    </a>
    <a href="#" id="more-toggle">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="5" r="1"/><circle cx="12" cy="12" r="1"/><circle cx="12" cy="19" r="1"/></svg>
      {t.common.more}
    </a>
  </nav>

  <script>
    // Hamburger menu
    document.getElementById('hamburger')?.addEventListener('click', () => {
      document.getElementById('mobile-menu')?.classList.add('open');
    });
    document.getElementById('menu-close')?.addEventListener('click', () => {
      document.getElementById('mobile-menu')?.classList.remove('open');
    });
    document.getElementById('mobile-menu')?.addEventListener('click', (e) => {
      if (e.target === e.currentTarget) document.getElementById('mobile-menu')?.classList.remove('open');
    });

    // Reading progress bar
    window.addEventListener('scroll', () => {
      const scrollTop = window.scrollY;
      const docHeight = document.documentElement.scrollHeight - window.innerHeight;
      const progress = docHeight > 0 ? (scrollTop / docHeight) * 100 : 0;
      const bar = document.getElementById('reading-progress');
      if (bar) bar.style.width = progress + '%';
    });
  </script>
</body>
</html>