---
import Layout from '../../../layouts/Layout.astro';
import SEOHead from '../../../components/SEOHead.astro';
import AdSlot from '../../../components/AdSlot.astro';
import { getTranslations } from '../../../i18n/index';
import { styles, styleNames } from '../../../i18n/categories';
import type { LocaleCode } from '../../../i18n/types';

export function getStaticPaths() {
  return styles.flatMap(st => [
    { params: { locale: 'zh', styleName: st } },
    { params: { locale: 'en', styleName: st } },
  ]);
}

const { locale, styleName } = Astro.params;
const t = getTranslations(locale as LocaleCode);
const name = styleNames[styleName]?.[locale as LocaleCode] || styleName;

const sampleArticles = [
  { title: locale === 'zh' ? `${name}装修的5个核心元素` : `5 Core Elements of ${name} Decor`, desc: locale === 'zh' ? `打造地道${name}风格的关键设计元素。` : `Key design elements to achieve an authentic ${name.toLowerCase()} look.`, slug: `${styleName}-core-elements`, views: 8200, date: '2026-05-06' },
  { title: locale === 'zh' ? `${name}风格色彩搭配指南` : `${name} Color Palette Guide`, desc: locale === 'zh' ? `${name}风格的色彩搭配方案，含色号推荐。` : `Color palette recommendations with hex codes for ${name.toLowerCase()} style.`, slug: `${styleName}-colors`, views: 9100, date: '2026-04-30' },
];
---

<Layout>
  <SEOHead
    title={locale === 'zh' ? `${name}装修风格指南` : `${name} Style Guide`}
    description={locale === 'zh' ? `小户型${name}装修风格设计灵感、色彩搭配和家具推荐。` : `${name} style design inspiration, color palettes, and furniture picks for small homes.`}
  />

  <div class="container" style="margin-top:2rem">
    <nav style="display:flex;gap:.5rem;flex-wrap:wrap;margin-bottom:1.5rem">
      {styles.map(s => (
        <a
          href={`/${locale}/style/${s}`}
          class={`btn ${s === styleName ? 'btn-primary' : 'btn-outline'}`}
          style="font-size:.85rem"
        >
          {styleNames[s]?.[locale as LocaleCode] || s}
        </a>
      ))}
    </nav>

    <h1>{locale === 'zh' ? `${name}风格` : `${name} Style`}</h1>
    <p style="color:var(--text-light);margin-bottom:1.5rem">
      {locale === 'zh' ? `共 ${sampleArticles.length} 篇文章 · 持续更新中` : `${sampleArticles.length} articles · Updated regularly`}
    </p>

    <AdSlot type="banner" />

    <div class="article-grid" style="margin-top:1.5rem">
      {sampleArticles.map(a => (
        <article class="card article-card">
          <img src="/og/default.jpg" alt={a.title} loading="lazy" class="article-card__image" width="600" height="375" />
          <div class="article-card__body">
            <a href={`/${locale}/articles/${a.slug}`} style="color:inherit">
              <h3 class="article-card__title">{a.title}</h3>
            </a>
            <p class="article-card__desc">{a.desc}</p>
            <div class="article-card__meta">
              <span>{a.date}</span>
              <span>{a.views.toLocaleString()} {t.article.views}</span>
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>
</Layout>