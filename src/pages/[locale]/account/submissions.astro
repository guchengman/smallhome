---
import Layout from '../../../layouts/Layout.astro';
import { getTranslations } from '../../../i18n/index';
import type { LocaleCode } from '../../../i18n/types';

export const prerender = false;

const locale = (Astro.params.locale || 'zh') as LocaleCode;
const t = getTranslations(locale);
const isZh = locale === 'zh';

const M = {
  noSubmissions: isZh ? '暂无投稿' : 'No submissions yet',
  startWriting: isZh ? '去投稿' : 'Write Article',
  loading: t.common.loading,
};
---

<Layout>
  <div class="account-layout">
    <aside class="account-sidebar">
      <a href={`/${locale}/account/`}>{t.account.title}</a>
      <a href={`/${locale}/account/submissions`} class="active">{t.account.submissions}</a>
      <a href={`/${locale}/editor/`}>{t.nav.submit}</a>
    </aside>

    <div>
      <h1>{t.account.submissions}</h1>
      <div id="submissions-list" style="margin-top:1rem"><p style="color:var(--text-light)">{M.loading}</p></div>
    </div>
  </div>
</Layout>

<script type="application/json" id="_m5">{JSON.stringify(M)}</script>
<script>
  var M6 = JSON.parse(document.getElementById('_m5')?.textContent || '{}');
  var editorUrl = '/editor/';

  (async function() {
    var token = localStorage.getItem('token');
    if (!token) { location.href = '/login'; return; }
    try {
      var res = await fetch('/api/auth/me', { headers: { Authorization: 'Bearer ' + token } });
      if (!res.ok) { localStorage.removeItem('token'); location.href = '/login'; return; }
    } catch(e) { location.href = '/login'; return; }

    document.getElementById('submissions-list').innerHTML =
      '<div class="card" style="padding:1.5rem;text-align:center"><p style="color:var(--text-light)">' + M6.noSubmissions + '</p>' +
      '<a href="' + editorUrl + '" class="btn btn-primary" style="margin-top:.75rem">' + M6.startWriting + '</a></div>';
  })();
</script>