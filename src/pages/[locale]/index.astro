---
import Layout from '../../layouts/Layout.astro';
import SEOHead from '../../components/SEOHead.astro';
import AdSlot from '../../components/AdSlot.astro';
import { getTranslations } from '../../i18n/index';
import type { LocaleCode } from '../../i18n/types';

export function getStaticPaths() {
  return [{ params: { locale: 'zh' } }, { params: { locale: 'en' } }];
}

const locale = (Astro.params.locale || 'zh') as LocaleCode;
const t = getTranslations(locale);

// En titles for B站 articles
const enTitles: Record<string, string> = {
  'bv1qgvdzrei7': 'Small Home Design Tips You Can\'t Miss',
  'bv1fo1qybe9d': '52sqm Tour: Real Renovation Living',
  'bv11u4y1a7qt': '31sqm Solo Living: Small Home, Big Heart',
  'bv155411w7dx': '7 Ways to Make Your Small Home Feel Bigger',
  'bv1vb4y157ny': '78sqm Small Home Tour for Renovation Ideas',
  'bv1ejhcz7e2n': '7sqm Bedroom Makeover You\'ll Love',
  'bv12h8jzzefe': 'Internet-Famous Decor Regrets After Moving In',
  'bv1yr5k6lejs': '90sqm Mid-Century Modern Small Home',
  'bv1ku411p7ub': '30 Living & Dining Room Decor Ideas',
  'bv1nriqyte8c': 'Ultimate Guide to Choosing a Good Floor Plan',
  'bv1ou4m1c724': '70sqm Modern Minimalist Renovation Review',
  'bv1dd5n6ge1s': 'Small Home Storage Secrets That Work',
  'bv1fmnoeyeb9': 'J-style Storage: 70sqm That Holds Everything',
  'bv1z4411x7qk': '15sqm Couple + Cat Space Miracle',
  'bv1mg411u7sd': '8 Storage Methods for Every Room',
  'bv1mxkhyyekm': 'Super Practical Storage Tips for Small Spaces',
  'bv1cacnycecm': 'Budget Storage Hacks That Double Your Space',
  'bv12p9cysexb': '20sqm Rental Storage Magic: Use Every Gap',
  'bv1dlkzztewh': 'Under $150 Bedroom Storage Makeover',
  'bv1sw5p63ech': 'Old Home Transformed Under $150',
  'bv1az4y1g7sd': 'Why Japanese Small Homes Feel So Spacious',
  'bv13c411a7ts': '89sqm Storage Paradise: Maxing Every Inch',
  'bv1fu4y1x7bp': 'IKEA Hacks: 6 Mini Storages in a Small Home',
  'bv1byolbneen': 'New Home Renovation? Start Here',
  'bv1wt9dy6eyd': '6sqm Bedroom Genius Design',
  'bv1xgqgyjesm': '200% Space Utilization for Small Homes',
  'bv1sx4y157gv': 'Invisible Storage: 100sqm Feels Like 200sqm',
  'bv147411m7st': 'China vs Germany: 18sqm Ultra-Small Home Challenge',
  'bv1bu4y1j7sj': 'Japanese 45sqm Apartment Minimalist Design',
  'bv1hxvyzaeu5': 'Visual Expansion Tricks for Small Spaces',
  'bv1zen1zse2j': 'DIY Home Design: Complete Process Guide',
  'bv1fx516vec3': 'Ultimate Small Home Transformation Guide',
  'bv1kge3zcehq': '92sqm Italian Minimalist: Trend or Timeless?',
  'bv13tolbzeap': '12 Decor Styles: Budget & Reality Check',
};

// Dynamic loading from markdown files via Astro.glob
const zhPosts = await Astro.glob('/src/content/articles/zh/*.md');

interface ArticleMeta {
  title: string;
  description: string;
  categories: string[];
  slug: string;
  image: string;
  views: number;
  date: string;
}

function getSlug(filePath: string): string {
  const parts = filePath.replace(/\\/g, '/').split('/');
  const name = parts.pop() || '';
  return name.replace(/\.md$/, '');
}

function articlesFromPosts(posts: typeof zhPosts, locale: string): ArticleMeta[] {
  return posts.map(post => {
    const slug = getSlug(post.file);
    const fm = post.frontmatter;
    return {
      title: locale === 'en' && enTitles[slug] ? enTitles[slug] : (fm.title || ''),
      description: fm.description || '',
      categories: (fm.categories as string[]) || ['tips'],
      slug,
      image: (fm.coverImage as string) || '/og/default.jpg',
      views: parseInt(String(fm.viewCount || '0'), 10),
      date: (fm.publishedAt as string) || '',
    };
  }).sort((a, b) => {
    const dc = b.date.localeCompare(a.date);
    if (dc !== 0) return dc;
    return b.views - a.views;
  });
}

const sampleArticles = articlesFromPosts(zhPosts, locale || 'zh').slice(0, 12);

const heroEntries = [
  { href: 'area/30-40sqm', label: t.home.areaEntry },
  { href: 'space/kitchen', label: t.home.spaceEntry },
  { href: 'budget/under-30k', label: t.home.budgetEntry },
  { href: 'style/nordic', label: t.home.styleEntry },
];
---

<Layout>
  <SEOHead
    title={locale === 'zh' ? '小家装修指南' : 'SmallHome Guide'}
    description={t.home.heroSubtitle}
  />

  <!-- Hero Section -->
  <section class="hero">
    <h1 class="hero__title">{t.home.heroTitle}</h1>
    <p class="hero__subtitle">{t.home.heroSubtitle}</p>
    <div class="hero__search">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg>
      <input
        type="search"
        placeholder={t.home.searchPlaceholder}
        id="hero-search"
      />
    </div>
    <div class="hero__entries">
      {heroEntries.map(e => (
        <a href={`/${locale}/${e.href}`} class="hero__entry">{e.label}</a>
      ))}
    </div>
  </section>

  <!-- Ad slot #1 -->
  <div class="container"><AdSlot type="banner" /></div>

  <!-- Latest articles -->
  <section class="container" style="margin-top:2rem">
    <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:1.25rem">
      <h2>{t.home.latestArticles}</h2>
      <a href={`/${locale}/articles`} class="btn btn-outline" style="font-size:.85rem">{t.home.viewAll}</a>
    </div>
    <div class="article-grid">
      {sampleArticles.map(article => (
        <article class="card article-card">
          <img src={article.image} alt={article.title} loading="lazy" class="article-card__image" width="600" height="375" />
          <div class="article-card__body">
            <a href={`/${locale}/articles/${article.slug}`} style="color:inherit">
              <h3 class="article-card__title">{article.title}</h3>
            </a>
            <p class="article-card__desc">{article.desc}</p>
            <div class="article-card__meta">
              <span>{article.date}</span>
              <span>{article.views.toLocaleString()} {t.article.views}</span>
            </div>
          </div>
        </article>
      ))}
    </div>
  </section>

  <!-- Ad slot #3 (in-feed) -->
  <div class="container"><AdSlot type="inarticle" /></div>

  <script>
  document.getElementById('hero-search')?.addEventListener('keydown', function(e) {
    if (e.key === 'Enter' && this.value.trim()) {
      location.href = '/search?q=' + encodeURIComponent(this.value.trim());
    }
  });
</script>
</Layout>