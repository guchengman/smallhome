---
import Layout from '../../../layouts/Layout.astro';
import SEOHead from '../../../components/SEOHead.astro';
import AdSlot from '../../../components/AdSlot.astro';
import { getTranslations } from '../../../i18n/index';
import type { LocaleCode } from '../../../i18n/types';

export function getStaticPaths() {
  return [{ params: { locale: 'zh' } }, { params: { locale: 'en' } }];
}

const locale = (Astro.params.locale || 'zh') as LocaleCode;
const t = getTranslations(locale);
const isZh = locale === 'zh';

const sampleArticles = [
  { title: isZh ? '装修合同中的10个常见陷阱' : '10 Common Traps in Renovation Contracts', desc: isZh ? '签合同前一定要看清这些条款，避免被坑。' : 'Must-check clauses before signing to avoid getting ripped off.', slug: 'contract-traps-2026', views: 8900, date: '2026-04-28' },
  { title: isZh ? '水电改造最容易忽略的7个问题' : '7 Often-Overlooked Electrical & Plumbing Issues', desc: isZh ? '水电改造是隐蔽工程，这些问题不注意后期维修成本巨大。' : 'Hidden work issues that cost a fortune to fix later.', slug: 'electrical-pitfalls', views: 12300, date: '2026-05-10' },
  { title: isZh ? '装修公司报价单怎么看？' : 'How to Read a Renovation Quote', desc: isZh ? '一份标准的装修报价单应该包含哪些项目？教你识破增项陷阱。' : 'What should a standard quote include? Learn to spot hidden fees.', slug: 'reading-quotes', views: 15600, date: '2026-05-06' },
  { title: isZh ? '甲醛检测的5个误区' : '5 Formaldehyde Testing Myths', desc: isZh ? '你以为通风几个月就安全了？关于甲醛你必须知道的真相。' : 'Think a few months of airing out is enough? The truth about formaldehyde.', slug: 'formaldehyde-myths', views: 7200, date: '2026-04-30' },
];
---

<Layout>
  <SEOHead
    title={t.categories.tips}
    description={isZh ? '装修避坑指南 — 合同陷阱、施工雷区、材料选购注意事项' : 'Renovation traps guide — contracts, construction pitfalls, material selection tips'}
  />

  <div class="container" style="margin-top:2rem">
    <h1>{t.nav.tips}</h1>
    <p style="color:var(--text-light);margin-bottom:1.5rem">
      {isZh ? `共 ${sampleArticles.length} 篇文章 · 持续更新中` : `${sampleArticles.length} articles · Updated regularly`}
    </p>

    <AdSlot type="banner" />

    <div class="article-grid" style="margin-top:1.5rem">
      {sampleArticles.map(a => (
        <article class="card article-card">
          <img src="/og/default.jpg" alt={a.title} loading="lazy" class="article-card__image" width="600" height="375" />
          <div class="article-card__body">
            <a href={`/${locale}/articles/${a.slug}`} style="color:inherit">
              <h3 class="article-card__title">{a.title}</h3>
            </a>
            <p class="article-card__desc">{a.desc}</p>
            <div class="article-card__meta">
              <span>{a.date}</span>
              <span>{a.views.toLocaleString()} {t.article.views}</span>
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>
</Layout>
