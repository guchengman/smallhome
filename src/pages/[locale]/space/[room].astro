---
import Layout from '../../../layouts/Layout.astro';
import SEOHead from '../../../components/SEOHead.astro';
import AdSlot from '../../../components/AdSlot.astro';
import { getTranslations } from '../../../i18n/index';
import { spaces, spaceNames } from '../../../i18n/categories';
import type { LocaleCode } from '../../../i18n/types';

export function getStaticPaths() {
  return spaces.flatMap(room => [
    { params: { locale: 'zh', room } },
    { params: { locale: 'en', room } },
  ]);
}

const { locale, room } = Astro.params;
const t = getTranslations(locale as LocaleCode);
const name = spaceNames[room]?.[locale as LocaleCode] || room;

// En titles for B站 articles (space category)
const enTitles: Record<string, string> = {
  'bv1dd5n6ge1s': 'Small Home Storage Secrets That Work',
  'bv1fmnoeyeb9': 'J-style Storage: 70sqm That Holds Everything',
  'bv1z4411x7qk': '15sqm Couple + Cat Space Miracle',
  'bv1mg411u7sd': '8 Storage Methods for Every Room',
  'bv1mxkhyyekm': 'Super Practical Storage Tips for Small Spaces',
  'bv1cacnycecm': 'Budget Storage Hacks That Double Your Space',
  'bv12p9cysexb': '20sqm Rental Storage Magic: Use Every Gap',
  'bv1dlkzztewh': 'Under $150 Bedroom Storage Makeover',
  'bv1az4y1g7sd': 'Why Japanese Small Homes Feel So Spacious',
  'bv13c411a7ts': '89sqm Storage Paradise: Maxing Every Inch',
  'bv1fu4y1x7bp': 'IKEA Hacks: 6 Mini Storages in a Small Home',
  'bv1ejhcz7e2n': '7sqm Bedroom Makeover You\'ll Love',
  'bv1wt9dy6eyd': '6sqm Bedroom Genius Design',
  'bv1xgqgyjesm': '200% Space Utilization for Small Homes',
  'bv1byolbneen': 'New Home Renovation? Start Here',
};

const zhPosts = await Astro.glob('/src/content/articles/zh/*.md');

interface ArticleMeta {
  title: string;
  description: string;
  slug: string;
  image: string;
  views: number;
  date: string;
}

function getSlug(filePath: string): string {
  const parts = filePath.replace(/\\/g, '/').split('/');
  const name = parts.pop() || '';
  return name.replace(/\.md$/, '');
}

const sampleArticles: ArticleMeta[] = zhPosts
  .filter(p => p.frontmatter.categories?.includes('space'))
  .filter(p => !p.frontmatter.room || p.frontmatter.room === room)
  .map(post => {
    const slug = getSlug(post.file);
    const fm = post.frontmatter;
    return {
      title: locale === 'en' && enTitles[slug] ? enTitles[slug] : (fm.title || ''),
      description: fm.description || '',
      slug,
      image: (fm.coverImage as string) || '/og/default.jpg',
      views: parseInt(String(fm.viewCount || '0'), 10),
      date: (fm.publishedAt as string) || '',
    };
  })
  .sort((a, b) => {
    const dc = b.date.localeCompare(a.date);
    if (dc !== 0) return dc;
    return b.views - a.views;
  });
---

<Layout>
  <SEOHead
    title={locale === 'zh' ? `${name}设计装修指南` : `${name} Design Guide`}
    description={locale === 'zh' ? `小户型${name}装修设计灵感、收纳方案和材料选购指南。` : `Small ${name.toLowerCase()} design ideas, storage solutions, and material selection guide.`}
  />

  <div class="container" style="margin-top:2rem">
    <nav style="display:flex;gap:.5rem;flex-wrap:wrap;margin-bottom:1.5rem">
      {spaces.map(s => (
        <a
          href={`/${locale}/space/${s}`}
          class={`btn ${s === room ? 'btn-primary' : 'btn-outline'}`}
          style="font-size:.85rem"
        >
          {spaceNames[s]?.[locale as LocaleCode] || s}
        </a>
      ))}
    </nav>

    <h1>{locale === 'zh' ? `${name}装修设计指南` : `${name} Design Guide`}</h1>
    <p style="color:var(--text-light);margin-bottom:1.5rem">
      {locale === 'zh' ? `共 ${sampleArticles.length} 篇文章 · 持续更新中` : `${sampleArticles.length} articles · Updated regularly`}
    </p>

    <AdSlot type="banner" />

    <div class="article-grid" style="margin-top:1.5rem">
      {sampleArticles.map(a => (
        <article class="card article-card">
          <img src={a.image} alt={a.title} loading="lazy" class="article-card__image" width="600" height="375" />
          <div class="article-card__body">
            <a href={`/${locale}/articles/${a.slug}`} style="color:inherit">
              <h3 class="article-card__title">{a.title}</h3>
            </a>
            <p class="article-card__desc">{a.desc}</p>
            <div class="article-card__meta">
              <span>{a.date}</span>
              <span>{a.views.toLocaleString()} {t.article.views}</span>
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>
</Layout>