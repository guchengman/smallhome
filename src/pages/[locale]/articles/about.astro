---
import Layout from '../../../layouts/Layout.astro';
import SEOHead from '../../../components/SEOHead.astro';
import type { LocaleCode } from '../../../i18n/types';

export function getStaticPaths() {
  return [{ params: { locale: 'zh' } }, { params: { locale: 'en' } }];
}

const locale = (Astro.params.locale || 'zh') as LocaleCode;
const isZh = locale === 'zh';
---

<Layout>
  <SEOHead
    title={isZh ? '关于我们' : 'About Us'}
    description={isZh ? 'SmallHome 小家装修指南 — 让每一平米都有价值' : 'SmallHome Guide — Make Every Square Meter Count'}
  />

  <div class="container" style="margin-top:2rem;max-width:720px">
    <h1>{isZh ? '关于 SmallHome' : 'About SmallHome'}</h1>

    <div class="card" style="padding:2rem;margin-top:1.5rem;line-height:1.9">
      {isZh ? (
        <>
          <p style="margin-bottom:1rem">SmallHome（小家装修指南）是一个专注于小户型空间利用的数据驱动型内容平台。</p>
          <p style="margin-bottom:1rem">我们相信，房子的大小并不决定生活品质的高低。无论你是30㎡的单身公寓，还是70㎡的三口之家，每一平米都值得被认真对待。</p>

          <h2 style="margin-top:2rem">我们的理念</h2>
          <ul style="margin-bottom:1rem;padding-left:1.5rem">
            <li><strong>数据驱动</strong> — 所有建议都有数据和案例分析支撑</li>
            <li><strong>实用导向</strong> — 不仅好看，更要好用</li>
            <li><strong>真实案例</strong> — 来自真实业主的装修经验分享</li>
            <li><strong>中立客观</strong> — 不收品牌推广费，只说真话</li>
          </ul>

          <h2 style="margin-top:2rem">内容分类</h2>
          <ul style="margin-bottom:1rem;padding-left:1.5rem">
            <li><strong>按面积</strong> — 不同面积段的装修方案</li>
            <li><strong>按空间</strong> — 厨房、卫生间、客厅等分区设计</li>
            <li><strong>按风格</strong> — 北欧、日式、现代简约等风格指南</li>
            <li><strong>按预算</strong> — 不同预算下的装修规划</li>
            <li><strong>避坑指南</strong> — 装修中的各种陷阱和注意事项</li>
            <li><strong>图鉴</strong> — 真实案例实景图赏</li>
          </ul>

          <h2 style="margin-top:2rem">联系我们</h2>
          <p>邮箱：<a href="mailto:hello@smallhome.top">hello@smallhome.top</a></p>
        </>
      ) : (
        <>
          <p style="margin-bottom:1rem">SmallHome is a data-driven content platform focused on small-space utilization in home design.</p>
          <p style="margin-bottom:1rem">We believe the size of your home doesn't determine your quality of life. Whether you're in a 30sqm studio or a 70sqm family apartment, every square meter counts.</p>

          <h2 style="margin-top:2rem">Our Philosophy</h2>
          <ul style="margin-bottom:1rem;padding-left:1.5rem">
            <li><strong>Data-Driven</strong> — All advice backed by data and case analysis</li>
            <li><strong>Practical Focus</strong> — Beautiful AND functional</li>
            <li><strong>Real Cases</strong> — Real renovation stories from real homeowners</li>
            <li><strong>Independent</strong> — No sponsored content, just honest reviews</li>
          </ul>

          <h2 style="margin-top:2rem">Contact</h2>
          <p>Email: <a href="mailto:hello@smallhome.top">hello@smallhome.top</a></p>
        </>
      )}
    </div>
  </div>
</Layout>
