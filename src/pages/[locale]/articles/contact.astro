---
import Layout from '../../../layouts/Layout.astro';
import SEOHead from '../../../components/SEOHead.astro';
import type { LocaleCode } from '../../../i18n/types';

export function getStaticPaths() {
  return [{ params: { locale: 'zh' } }, { params: { locale: 'en' } }];
}

const locale = (Astro.params.locale || 'zh') as LocaleCode;
const isZh = locale === 'zh';
---

<Layout>
  <SEOHead
    title={isZh ? '联系我们' : 'Contact Us'}
    description={isZh ? '联系 SmallHome 小家装修指南' : 'Contact SmallHome Guide'}
  />

  <div class="container" style="margin-top:2rem;max-width:680px">
    <h1>{isZh ? '联系我们' : 'Contact Us'}</h1>

    <div class="card" style="padding:2rem;margin-top:1.5rem">
      {isZh ? (
        <>
          <p style="margin-bottom:1.5rem">有任何建议、投稿意向或合作需求，欢迎通过以下方式联系我们。</p>
          <div class="form-group"><label>邮箱</label><p style="padding:.65rem 0"><a href="mailto:zengxiao892@gmail.com">zengxiao892@gmail.com</a></p></div>
          <div class="form-group"><label>{isZh ? '社交媒体' : 'Social'}</label><p style="padding:.65rem 0">{isZh ? '微信公众号：装修指南 SmallHome' : 'WeChat: SmallHome Guide'}</p></div>
          <div class="form-group"><label>{isZh ? '投稿' : 'Submissions'}</label><p style="padding:.65rem 0">{isZh ? '注册后即可在个人中心提交文章，审核通过后发布。' : 'Register and submit articles via your account dashboard.'}</p></div>
        </>
      ) : (
        <>
          <p style="margin-bottom:1.5rem">For suggestions, submissions, or collaboration inquiries, please reach out.</p>
          <div class="form-group"><label>Email</label><p style="padding:.65rem 0"><a href="mailto:zengxiao892@gmail.com">zengxiao892@gmail.com</a></p></div>
          <div class="form-group"><label>Submissions</label><p style="padding:.65rem 0">Register and submit articles via your account dashboard for review.</p></div>
        </>
      )}
    </div>
  </div>
</Layout>
