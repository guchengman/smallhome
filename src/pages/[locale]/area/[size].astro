---
import Layout from '../../../layouts/Layout.astro';
import SEOHead from '../../../components/SEOHead.astro';
import AdSlot from '../../../components/AdSlot.astro';
import { getTranslations } from '../../../i18n/index';
import { areaRanges } from '../../../i18n/categories';
import type { LocaleCode } from '../../../i18n/types';

export function getStaticPaths() {
  const areas = ['30-40sqm', '40-50sqm', '50-70sqm', '70-90sqm'];
  return areas.flatMap(size => [
    { params: { locale: 'zh', size } },
    { params: { locale: 'en', size } },
  ]);
}

const { locale, size } = Astro.params;
const t = getTranslations(locale as LocaleCode);
const range = areaRanges.find(a => a.slug === size);
const areaLabel = range ? (locale === 'zh' ? `${range.min}-${range.max}㎡` : `${range.min}-${range.max} sqm`) : size;

// En titles for B站 articles
const enTitles: Record<string, string> = {
  'bv1qgvdzrei7': 'Small Home Design Tips You Can\'t Miss',
  'bv1fo1qybe9d': '52sqm Tour: Real Renovation Living',
  'bv11u4y1a7qt': '31sqm Solo Living: Small Home, Big Heart',
  'bv1vb4y157ny': '78sqm Small Home Tour for Renovation Ideas',
  'bv1yr5k6lejs': '90sqm Mid-Century Modern Small Home',
  'bv1ou4m1c724': '70sqm Modern Minimalist Renovation Review',
  'bv1sw5p63ech': 'Old Home Transformed Under $150',
  'bv1sx4y157gv': 'Invisible Storage: 100sqm Feels Like 200sqm',
  'bv147411m7st': 'China vs Germany: 18sqm Ultra-Small Home Challenge',
  'bv1bu4y1j7sj': 'Japanese 45sqm Apartment Minimalist Design',
};

const zhPosts = await Astro.glob('/src/content/articles/zh/*.md');

interface ArticleMeta {
  title: string;
  description: string;
  slug: string;
  image: string;
  views: number;
  date: string;
}

function getSlug(filePath: string): string {
  const parts = filePath.replace(/\\/g, '/').split('/');
  const name = parts.pop() || '';
  return name.replace(/\.md$/, '');
}

const sampleArticles: ArticleMeta[] = zhPosts
  .filter(p => p.frontmatter.categories?.includes('area'))
  .filter(p => !p.frontmatter.areaSize || p.frontmatter.areaSize === size)
  .map(post => {
    const slug = getSlug(post.file);
    const fm = post.frontmatter;
    return {
      title: locale === 'en' && enTitles[slug] ? enTitles[slug] : (fm.title || ''),
      description: fm.description || '',
      slug,
      image: (fm.coverImage as string) || '/og/default.jpg',
      views: parseInt(String(fm.viewCount || '0'), 10),
      date: (fm.publishedAt as string) || '',
    };
  })
  .sort((a, b) => {
    const dc = b.date.localeCompare(a.date);
    if (dc !== 0) return dc;
    return b.views - a.views;
  });
---

<Layout>
  <SEOHead
    title={locale === 'zh' ? `${areaLabel}小户型装修方案` : `Small Home Design for ${areaLabel}`}
    description={locale === 'zh' ? `${areaLabel}小户型装修设计指南，含布局方案、预算规划和实景案例。` : `Design guide for ${areaLabel} homes with layouts, budgets, and real examples.`}
  />

  <div class="container" style="margin-top:2rem">
    <nav style="display:flex;gap:.5rem;flex-wrap:wrap;margin-bottom:1.5rem">
      {areaRanges.map(a => (
        <a
          href={`/${locale}/area/${a.slug}`}
          class={`btn ${a.slug === size ? 'btn-primary' : 'btn-outline'}`}
          style="font-size:.85rem"
        >
          {locale === 'zh' ? `${a.min}-${a.max}㎡` : `${a.min}-${a.max} sqm`}
        </a>
      ))}
    </nav>

    <h1>{locale === 'zh' ? `${areaLabel}小户型装修方案` : `Small Home Design: ${areaLabel}`}</h1>
    <p style="color:var(--text-light);margin-bottom:1.5rem">
      {locale === 'zh' ? `共 ${sampleArticles.length} 篇文章 · 持续更新中` : `${sampleArticles.length} articles · Updated regularly`}
    </p>

    <AdSlot type="banner" />

    <div class="article-grid" style="margin-top:1.5rem">
      {sampleArticles.map(a => (
        <article class="card article-card">
          <img src={a.image} alt={a.title} loading="lazy" class="article-card__image" width="600" height="375" />
          <div class="article-card__body">
            <a href={`/${locale}/articles/${a.slug}`} style="color:inherit">
              <h3 class="article-card__title">{a.title}</h3>
            </a>
            <p class="article-card__desc">{a.desc}</p>
            <div class="article-card__meta">
              <span>{a.date}</span>
              <span>{a.views.toLocaleString()} {t.article.views}</span>
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>
</Layout>