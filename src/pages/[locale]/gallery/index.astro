---
import Layout from '../../../layouts/Layout.astro';
import SEOHead from '../../../components/SEOHead.astro';
import AdSlot from '../../../components/AdSlot.astro';
import { getTranslations } from '../../../i18n/index';
import type { LocaleCode } from '../../../i18n/types';

export function getStaticPaths() {
  return [{ params: { locale: 'zh' } }, { params: { locale: 'en' } }];
}

const locale = (Astro.params.locale || 'zh') as LocaleCode;
const t = getTranslations(locale);
const isZh = locale === 'zh';

const sampleArticles = [
  { title: isZh ? '30㎡北欧风小家实景图赏' : '30sqm Scandinavian Home Tour', desc: isZh ? '实景拍摄，每一寸空间都精致实用。' : 'Real photos of a beautifully designed compact home.', slug: '30sqm-scandi-tour', views: 18500, date: '2026-05-12' },
  { title: isZh ? '奶油风客厅设计集锦' : 'Cream-Style Living Room Collection', desc: isZh ? '30个奶油风客厅设计案例，每一张都是灵感。' : '30 cream-style living room designs for inspiration.', slug: 'cream-living-gallery', views: 14200, date: '2026-05-09' },
  { title: isZh ? '日式收纳的神仙操作' : 'Japandi Storage Inspirations', desc: isZh ? '这些收纳设计不仅好看，还好用到哭。' : 'Storage designs that are both beautiful and incredibly functional.', slug: 'japandi-storage-gallery', views: 11000, date: '2026-05-05' },
  { title: isZh ? '阳台改造案例精选' : 'Balcony Makeover Gallery', desc: isZh ? '小阳台的N种可能，从晾晒区到休闲花园。' : 'N possibilities for small balconies, from laundry to garden.', slug: 'balcony-makeovers', views: 9600, date: '2026-05-01' },
];
---

<Layout>
  <SEOHead
    title={t.categories.gallery}
    description={isZh ? '小户型装修实景图鉴 — 北欧、日式、现代简约等风格案例' : 'Small home design gallery — Scandinavian, Japandi, modern minimalist real cases'}
  />

  <div class="container" style="margin-top:2rem">
    <h1>{t.nav.gallery}</h1>
    <p style="color:var(--text-light);margin-bottom:1.5rem">
      {isZh ? `共 ${sampleArticles.length} 个案例 · 持续更新中` : `${sampleArticles.length} cases · Updated regularly`}
    </p>

    <AdSlot type="banner" />

    <div class="article-grid" style="margin-top:1.5rem">
      {sampleArticles.map(a => (
        <article class="card article-card">
          <img src="/og/default.jpg" alt={a.title} loading="lazy" class="article-card__image" width="600" height="375" />
          <div class="article-card__body">
            <a href={`/${locale}/articles/${a.slug}`} style="color:inherit">
              <h3 class="article-card__title">{a.title}</h3>
            </a>
            <p class="article-card__desc">{a.desc}</p>
            <div class="article-card__meta">
              <span>{a.date}</span>
              <span>{a.views.toLocaleString()} {t.article.views}</span>
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>
</Layout>
