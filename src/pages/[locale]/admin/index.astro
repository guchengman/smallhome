---
import Layout from '../../../layouts/Layout.astro';
import StatusBadge from '../../../components/StatusBadge.astro';
import { getTranslations } from '../../../i18n/index';
import type { LocaleCode } from '../../../i18n/types';

export const prerender = false;

const locale = (Astro.params.locale || 'zh') as LocaleCode;
const t = getTranslations(locale);
const isZh = locale === 'zh';

const msgs = {
  loading: isZh ? '加载中...' : 'Loading...',
  approveConfirm: isZh ? '确认通过这篇稿件？' : 'Approve this submission?',
  rejectReasonRequired: isZh ? '请填写驳回理由' : 'Please provide a rejection reason',
  reviewed: isZh ? '已审核' : 'Reviewed',
  users: isZh ? '用户管理' : 'Users',
};

const pendingArticles = [
  { id: 1, title: isZh ? '小厨房收纳神器推荐' : 'Small Kitchen Storage Recommendations', author: 'user123', date: '2026-05-15', category: 'space', status: 'pending' as const },
  { id: 2, title: isZh ? '30平米loft装修实录' : '30sqm Loft Renovation Diary', author: 'designer_wang', date: '2026-05-14', category: 'area', status: 'pending' as const },
];
---

<Layout>
  <div class="container" style="margin-top:2rem">
    <h1>{t.admin.title}</h1>
    <div style="display:flex;gap:1rem;margin-top:1rem;margin-bottom:1.5rem">
      <a href={`/${locale}/admin/`} class="btn btn-primary">{t.admin.reviewQueue}</a>
      <a href="#" class="btn btn-outline">{msgs.reviewed}</a>
      <a href="#" class="btn btn-outline">{msgs.users}</a>
    </div>

    <h2>{t.admin.reviewQueue} ({pendingArticles.length})</h2>

    {pendingArticles.length === 0 ? (
      <div class="card" style="padding:2rem;text-align:center;margin-top:1rem">
        <p style="color:var(--text-light)">{t.admin.noPending}</p>
      </div>
    ) : (
      <div class="review-grid" style="margin-top:1rem">
        {pendingArticles.map(article => (
          <div class="card review-card">
            <h3 class="review-card__title">{article.title}</h3>
            <div class="review-card__meta">
              <span>{t.article.author}: {article.author}</span>
              <span> · {article.date}</span>
            </div>
            <div style="margin-bottom:.75rem">
              <span class="tag">{t.categories[article.category] || article.category}</span>
              <StatusBadge status={article.status} />
            </div>
            <div class="review-card__actions">
              <button class="btn btn-outline preview-btn" data-id={article.id}>{t.admin.preview}</button>
              <button class="btn btn-primary approve-btn" data-id={article.id} style="background:var(--success)">{t.admin.approve}</button>
              <button class="btn btn-outline reject-btn" data-id={article.id} style="color:#dc2626;border-color:#dc2626">{t.admin.reject}</button>
            </div>
          </div>
        ))}
      </div>
    )}
  </div>

  <!-- Preview modal -->
  <div class="modal-overlay" id="preview-modal" style="display:none">
    <div class="modal" style="max-width:720px;max-height:90vh">
      <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:1rem">
        <h2>{t.admin.preview}</h2>
        <button class="btn btn-ghost" id="preview-close" style="font-size:1.2rem">&times;</button>
      </div>
      <div id="preview-content"></div>
    </div>
  </div>

  <!-- Reject modal -->
  <div class="modal-overlay" id="reject-modal" style="display:none">
    <div class="modal">
      <h2>{t.admin.reject}</h2>
      <div class="form-group" style="margin-top:1rem">
        <label>{t.admin.rejectReason}</label>
        <textarea id="reject-reason" rows="3"></textarea>
      </div>
      <div style="display:flex;gap:.5rem;justify-content:flex-end;margin-top:1rem">
        <button class="btn btn-outline" id="reject-cancel">{t.common.cancel}</button>
        <button class="btn btn-primary" id="reject-confirm" style="background:#dc2626">{t.admin.reject}</button>
      </div>
    </div>
  </div>
</Layout>

<script>
  var _msgs = {js:import.meta.env.SSR ? null : JSON.parse(document.getElementById('_msgs')?.textContent || '{}')};
</script>
<script type="application/json" id="_msgs">{JSON.stringify(msgs)}</script>
<script>
  var msgsData = JSON.parse(document.getElementById('_msgs')?.textContent || '{}');
  var currentArticleId = null;
  var token = localStorage.getItem('token');

  document.querySelectorAll('.preview-btn').forEach(function(btn) {
    btn.addEventListener('click', function() {
      document.getElementById('preview-modal').style.display = 'flex';
      document.getElementById('preview-content').innerHTML = '<p>' + msgsData.loading + '</p>';
    });
  });

  document.getElementById('preview-close')?.addEventListener('click', function() {
    document.getElementById('preview-modal').style.display = 'none';
  });

  document.querySelectorAll('.approve-btn').forEach(function(btn) {
    btn.addEventListener('click', async function() {
      if (!confirm(msgsData.approveConfirm)) return;
      var self = this;
      var res = await fetch('/api/admin/approve', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', Authorization: 'Bearer ' + token },
        body: JSON.stringify({ id: parseInt(self.dataset.id || '0') }),
      });
      var data = await res.json();
      if (res.ok) { self.closest('.review-card')?.remove(); }
      else { alert(data.error); }
    });
  });

  document.querySelectorAll('.reject-btn').forEach(function(btn) {
    btn.addEventListener('click', function() {
      currentArticleId = parseInt(this.dataset.id || '0');
      document.getElementById('reject-modal').style.display = 'flex';
    });
  });

  document.getElementById('reject-cancel')?.addEventListener('click', function() {
    document.getElementById('reject-modal').style.display = 'none';
  });

  document.getElementById('reject-confirm')?.addEventListener('click', async function() {
    var reason = document.getElementById('reject-reason').value.trim();
    if (!reason) return alert(msgsData.rejectReasonRequired);
    var res = await fetch('/api/admin/reject', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', Authorization: 'Bearer ' + token },
      body: JSON.stringify({ id: currentArticleId, reason: reason }),
    });
    var data = await res.json();
    if (res.ok) {
      document.getElementById('reject-modal').style.display = 'none';
      document.querySelector('.reject-btn[data-id="' + currentArticleId + '"]')?.closest('.review-card')?.remove();
    } else {
      alert(data.error);
    }
  });
</script>