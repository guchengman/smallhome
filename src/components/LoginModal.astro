---
interface Props {
  locale?: string;
  mode?: 'login' | 'register';
}

const { locale = 'zh', mode = 'login' } = Astro.props;
const isZh = locale === 'zh';
---

<div class="modal-overlay" id="auth-modal" style="display:none">
  <div class="modal">
    <button class="btn btn-ghost" id="modal-close" style="position:absolute;top:.5rem;right:.5rem;font-size:1.2rem">&times;</button>

    <!-- Login form -->
    <div id="login-form" style={mode === 'login' ? '' : 'display:none'}>
      <form id="login-form-el">
        <h2 class="modal__title">{isZh ? '登录账户' : 'Sign In'}</h2>
        <div class="form-group">
          <label>{isZh ? '用户名' : 'Username'}</label>
          <input type="text" id="login-username" autocomplete="username" />
        </div>
        <div class="form-group">
          <label>{isZh ? '密码' : 'Password'}</label>
          <input type="password" id="login-password" autocomplete="current-password" />
        </div>
        <button type="submit" class="btn btn-primary" style="width:100%" id="login-submit">
          {isZh ? '登录' : 'Sign In'}
        </button>
      </form>
      <div class="form-footer">
        <a href="#" id="show-register">{isZh ? '还没有账户？注册' : "Don't have an account? Register"}</a>
        <span style="margin:0 .5rem">|</span>
        <a href="#" id="show-reset">{isZh ? '忘记密码？' : 'Forgot password?'}</a>
      </div>
    </div>

    <!-- Register form step 1 -->
    <div id="register-form" style={mode === 'login' ? 'display:none' : ''}>
      <form id="register-form-el">
        <h2 class="modal__title">{isZh ? '注册账户' : 'Create Account'}</h2>
        <div class="form-group">
          <label>{isZh ? '用户名' : 'Username'}</label>
          <input type="text" id="reg-username" autocomplete="username" minlength="3" />
          <p id="username-check" class="form-hint"></p>
        </div>
        <div class="form-group">
          <label>{isZh ? '邮箱' : 'Email'}</label>
          <input type="email" id="reg-email" autocomplete="email" />
        </div>
        <div class="form-group">
          <label>{isZh ? '密码' : 'Password'} ({isZh ? '最少6位' : 'min 6 chars'})</label>
          <input type="password" id="reg-password" autocomplete="new-password" minlength="6" />
        </div>
        <div class="form-group">
          <label>{isZh ? '确认密码' : 'Confirm Password'}</label>
          <input type="password" id="reg-password2" autocomplete="new-password" minlength="6" />
        </div>
        <button type="submit" class="btn btn-primary" style="width:100%" id="send-code-btn">
          {isZh ? '发送验证码' : 'Send Code'}
        </button>
      </form>
      <div class="form-footer">
        <a href="#" id="show-login">{isZh ? '已有账户？登录' : 'Already have an account? Sign In'}</a>
      </div>
    </div>

    <!-- Register form step 2 -->
    <div id="verify-form" style="display:none">
      <form id="verify-form-el">
        <h2 class="modal__title">{isZh ? '验证邮箱' : 'Verify Email'}</h2>
        <p style="text-align:center;margin-bottom:1rem;color:var(--text-light)">
          {isZh ? '验证码已发送至 ' : 'Verification code sent to '}<strong id="verify-email-display"></strong>
        </p>
        <div class="form-group">
          <label>{isZh ? '验证码' : 'Verification Code'}</label>
          <input type="text" id="verify-code" maxlength="6" placeholder="000000" />
        </div>
        <button type="submit" class="btn btn-primary" style="width:100%" id="verify-submit">
          {isZh ? '完成注册' : 'Complete Registration'}
        </button>
      </form>
    </div>

    <!-- Reset password step 1 -->
    <div id="reset-form" style="display:none">
      <form id="reset-form-el">
        <h2 class="modal__title">{isZh ? '重置密码' : 'Reset Password'}</h2>
        <div class="form-group">
          <label>{isZh ? '邮箱' : 'Email'}</label>
          <input type="email" id="reset-email" />
        </div>
        <button type="submit" class="btn btn-primary" style="width:100%" id="reset-send-code">
          {isZh ? '发送验证码' : 'Send Code'}
        </button>
      </form>
      <div class="form-footer">
        <a href="#" id="show-login2">{isZh ? '返回登录' : 'Back to Sign In'}</a>
      </div>
    </div>

    <!-- Reset password step 2 -->
    <div id="reset-password-form" style="display:none">
      <form id="reset-password-form-el">
        <h2 class="modal__title">{isZh ? '设置新密码' : 'Set New Password'}</h2>
        <div class="form-group">
          <label>{isZh ? '验证码' : 'Verification Code'}</label>
          <input type="text" id="reset-code" maxlength="6" autocomplete="one-time-code" />
        </div>
        <div class="form-group">
          <label>{isZh ? '新密码' : 'New Password'}</label>
          <input type="password" id="reset-new-password" minlength="6" autocomplete="new-password" />
        </div>
        <div class="form-group">
          <label>{isZh ? '确认密码' : 'Confirm Password'}</label>
          <input type="password" id="reset-new-password2" minlength="6" autocomplete="new-password" />
        </div>
        <button type="submit" class="btn btn-primary" style="width:100%" id="reset-submit">
          {isZh ? '重置密码' : 'Reset Password'}
        </button>
      </form>
    </div>
  </div>
</div>

<script>
  // Simple form switching logic - actual API calls in separate client script
  const modal = document.getElementById('auth-modal');
  const forms = {
    login: document.getElementById('login-form'),
    register: document.getElementById('register-form'),
    verify: document.getElementById('verify-form'),
    reset: document.getElementById('reset-form'),
    resetPassword: document.getElementById('reset-password-form'),
  };

  function showForm(name: string) {
    Object.values(forms).forEach(f => { if (f) f.style.display = 'none'; });
    const target = forms[name as keyof typeof forms];
    if (target) target.style.display = '';
  }

  function openModal(mode: string) {
    if (modal) modal.style.display = 'flex';
    showForm(mode === 'register' ? 'register' : 'login');
  }
  function closeModal() { if (modal) modal.style.display = 'none'; }

  document.getElementById('modal-close')?.addEventListener('click', closeModal);
  modal?.addEventListener('click', (e) => { if (e.target === e.currentTarget) closeModal(); });

  document.getElementById('show-register')?.addEventListener('click', (e) => { e.preventDefault(); showForm('register'); });
  document.getElementById('show-login')?.addEventListener('click', (e) => { e.preventDefault(); showForm('login'); });
  document.getElementById('show-login2')?.addEventListener('click', (e) => { e.preventDefault(); showForm('login'); });
  document.getElementById('show-reset')?.addEventListener('click', (e) => { e.preventDefault(); showForm('reset'); });

  // Attach to global scope for nav buttons
  (window as any).__openAuthModal = openModal;

  // Username check
  let usernameCheckTimer: ReturnType<typeof setTimeout>;
  document.getElementById('reg-username')?.addEventListener('input', function(this: HTMLInputElement) {
    clearTimeout(usernameCheckTimer);
    const val = this.value.trim();
    if (val.length < 3) return;
    usernameCheckTimer = setTimeout(async () => {
      try {
        const res = await fetch(`/api/auth/check-username?username=${encodeURIComponent(val)}`);
        const data = await res.json();
        const el = document.getElementById('username-check');
        if (el) {
          el.textContent = data.exists ? '用户名已注册' : '用户名可用';
          el.className = data.exists ? 'form-error' : 'form-hint';
          el.style.color = data.exists ? '' : 'var(--success)';
        }
      } catch {}
    }, 400);
  });

  // Send code (register step 1 -> step 2)
  document.getElementById('send-code-btn')?.addEventListener('click', async (e) => {
    e.preventDefault();
    const email = (document.getElementById('reg-email') as HTMLInputElement).value.trim();
    if (!email.includes('@')) return alert('请输入有效邮箱');
    const res = await fetch('/api/auth/send-code', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ email }),
    });
    const data = await res.json();
    if (!res.ok) return alert(data.error);
    document.getElementById('verify-email-display')!.textContent = email;
    showForm('verify');
  });

  // Verify and register
  document.getElementById('verify-submit')?.addEventListener('click', async (e) => {
    e.preventDefault();
    const username = (document.getElementById('reg-username') as HTMLInputElement).value.trim();
    const email = (document.getElementById('reg-email') as HTMLInputElement).value.trim();
    const password = (document.getElementById('reg-password') as HTMLInputElement).value;
    const password2 = (document.getElementById('reg-password2') as HTMLInputElement).value;
    const code = (document.getElementById('verify-code') as HTMLInputElement).value.trim();

    if (password !== password2) return alert('两次密码不一致');
    if (password.length < 6) return alert('密码至少6位');

    const res = await fetch('/api/auth/register', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ username, email, password, code }),
    });
    const data = await res.json();
    if (!res.ok) return alert(data.error);
    localStorage.setItem('token', data.token);
    closeModal();
    location.href = '/';
  });

  // Login
  document.getElementById('login-submit')?.addEventListener('click', async (e) => {
    e.preventDefault();
    const username = (document.getElementById('login-username') as HTMLInputElement).value.trim();
    const password = (document.getElementById('login-password') as HTMLInputElement).value;
    const res = await fetch('/api/auth/login', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ username, password }),
    });
    const data = await res.json();
    if (!res.ok) return alert(data.error);
    if (data.needSetupPassword) { showForm('resetPassword'); return; }
    localStorage.setItem('token', data.token);
    closeModal();
    location.href = '/';
  });

  // Reset: send code
  document.getElementById('reset-send-code')?.addEventListener('click', async (e) => {
    e.preventDefault();
    const email = (document.getElementById('reset-email') as HTMLInputElement).value.trim();
    if (!email.includes('@')) return alert('请输入有效邮箱');
    const res = await fetch('/api/auth/send-code', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ email, purpose: 'reset' }),
    });
    const data = await res.json();
    if (!res.ok) return alert(data.error);
    showForm('resetPassword');
  });

  // Reset: submit new password
  document.getElementById('reset-submit')?.addEventListener('click', async (e) => {
    e.preventDefault();
    const email = (document.getElementById('reset-email') as HTMLInputElement).value.trim();
    const code = (document.getElementById('reset-code') as HTMLInputElement).value.trim();
    const p1 = (document.getElementById('reset-new-password') as HTMLInputElement).value;
    const p2 = (document.getElementById('reset-new-password2') as HTMLInputElement).value;
    if (p1 !== p2) return alert('两次密码不一致');
    if (p1.length < 6) return alert('密码至少6位');
    const res = await fetch('/api/auth/reset-password', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ email, code, newPassword: p1 }),
    });
    const data = await res.json();
    if (!res.ok) return alert(data.error);
    alert('密码重置成功');
    showForm('login');
  });
</script>