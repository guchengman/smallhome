---
interface Props {
  title: string;
  description: string;
  image?: string;
  canonicalURL?: string;
  type?: string;
  locale?: string;
  publishedAt?: string;
  updatedAt?: string;
  author?: string;
  tags?: string[];
}

const {
  title,
  description,
  image = '/og/default.jpg',
  canonicalURL,
  type = 'website',
  locale = 'zh',
  publishedAt,
  updatedAt,
  author = 'SmallHome',
  tags = [],
} = Astro.props;

const siteName = locale === 'zh' ? '小家装修指南' : 'SmallHome Guide';
const fullTitle = `${title} — ${siteName}`;
const url = canonicalURL || Astro.url.href;
---

<title>{fullTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={url} />

<!-- Open Graph -->
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={url} />
<meta property="og:type" content={type} />
<meta property="og:site_name" content={siteName} />
<meta property="og:image" content={new URL(image, Astro.url).href} />
<meta property="og:locale" content={locale === 'zh' ? 'zh_CN' : 'en_US'} />

<!-- Twitter -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={new URL(image, Astro.url).href} />

<!-- Article specific -->
{type === 'article' && publishedAt && <meta property="article:published_time" content={publishedAt} />}
{type === 'article' && updatedAt && <meta property="article:modified_time" content={updatedAt} />}
{type === 'article' && <meta property="article:author" content={author} />}
{tags.map(tag => <meta property="article:tag" content={tag} />)}

<!-- Schema.org -->
<script type="application/ld+json" set:html={JSON.stringify({
  '@context': 'https://schema.org',
  '@type': type === 'article' ? 'Article' : 'WebSite',
  name: title,
  description,
  url,
  ...(type === 'article' ? {
    headline: title,
    image: new URL(image, Astro.url).href,
    datePublished: publishedAt,
    dateModified: updatedAt || publishedAt,
    author: { '@type': 'Person', name: author },
    publisher: { '@type': 'Organization', name: siteName },
    mainEntityOfPage: { '@type': 'WebPage', '@id': url },
  } : {
    publisher: { '@type': 'Organization', name: siteName },
  }),
})} />

<!-- Breadcrumb schema for articles -->
{type === 'article' && (
  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: siteName, item: new URL('/', Astro.url).href },
      { '@type': 'ListItem', position: 2, name: title, item: url },
    ],
  })} />
)}