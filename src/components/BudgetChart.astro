---
interface Props {
  data: Array<{ label: string; value: number; color?: string }>;
  title?: string;
  total?: number;
}

const colors = ['#d97706', '#059669', '#3b82f6', '#8b5cf6', '#ec4899', '#f59e0b'];
const { data, title, total } = Astro.props;
const computedTotal = total || data.reduce((sum, d) => sum + d.value, 0);

const pieData = data.map((d, i) => {
  const pct = computedTotal > 0 ? (d.value / computedTotal) * 100 : 0;
  return { ...d, pct: Math.round(pct * 10) / 10, color: d.color || colors[i % colors.length] };
});
const chartId = `pie-${title?.replace(/\s/g,'') || 'chart'}`;
---

<div class="budget-chart" style="text-align:center;margin:1.5rem 0">
  {title && <p style="font-weight:600;margin-bottom:1rem">{title}</p>}
  <div style="display:flex;align-items:center;gap:1.5rem;justify-content:center;flex-wrap:wrap">
    <canvas id={chartId} width="200" height="200" style="max-width:200px"
      data-total={computedTotal}
      data-segments={JSON.stringify(pieData.map(d => ({ label: d.label, value: d.value, color: d.color })))}>
    </canvas>
    <div style="text-align:left">
      {pieData.map((d, i) => (
        <div key={i} style="display:flex;align-items:center;gap:.5rem;margin-bottom:.4rem;font-size:.85rem">
          <span style={`width:12px;height:12px;border-radius:3px;background:${d.color};flex-shrink:0`}></span>
          <span>{d.label}</span>
          <span style="font-weight:600;margin-left:auto;padding-left:.5rem">{d.pct}%</span>
        </div>
      ))}
      <div style="border-top:1px solid var(--border);padding-top:.4rem;margin-top:.4rem;font-weight:600">
        {computedTotal.toLocaleString()} 元
      </div>
    </div>
  </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
  document.querySelectorAll('.budget-chart canvas').forEach(function(canvas) {
    var total = parseFloat(canvas.getAttribute('data-total') || '0');
    var segments = JSON.parse(canvas.getAttribute('data-segments') || '[]');
    var ctx = canvas.getContext('2d');
    if (!ctx) return;
    var dpr = window.devicePixelRatio || 1;
    var size = 200;
    canvas.width = size * dpr;
    canvas.height = size * dpr;
    ctx.scale(dpr, dpr);
    var cx = size / 2, cy = size / 2, r = 90;
    var angle = -Math.PI / 2;
    segments.forEach(function(s) {
      var slice = (s.value / total) * Math.PI * 2;
      ctx.beginPath();
      ctx.moveTo(cx, cy);
      ctx.arc(cx, cy, r, angle, angle + slice);
      ctx.closePath();
      ctx.fillStyle = s.color;
      ctx.fill();
      ctx.strokeStyle = '#fff';
      ctx.lineWidth = 1.5;
      ctx.stroke();
      angle += slice;
    });
    ctx.beginPath();
    ctx.arc(cx, cy, r * .55, 0, Math.PI * 2);
    ctx.fillStyle = '#fff';
    ctx.fill();
  });
});
</script>